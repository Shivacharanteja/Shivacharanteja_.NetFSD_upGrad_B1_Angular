
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>CheckAge</title>
</head>
<body>
    @{
        int age = ViewBag.Age;
    }

    @if (age >= 18)
    {
        <p>Eligible to vote</p>
    }
    else
    {
        <p>Not eligible</p>
    }
</body>
</html>
