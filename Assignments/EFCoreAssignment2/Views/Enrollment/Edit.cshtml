@model EFCoreAssignment2.Entities.Enrollment
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>


<h2>Edit Enrollment</h2>

<form method="post">
    <input type="hidden" asp-for="Id" />

    <label>Student</label>
    <select asp-for="StudentId" asp-items="ViewBag.Students"></select><br />

    <label>Course</label>
    <select asp-for="CourseId" asp-items="ViewBag.Courses"></select><br />

    <label>Grade</label>
    <input type="text" asp-for="Grade" /><br />

    <button type="submit">Update</button>
</form>
