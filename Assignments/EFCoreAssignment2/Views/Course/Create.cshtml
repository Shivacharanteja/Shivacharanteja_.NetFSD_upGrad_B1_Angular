@model EFCoreAssignment2.Entities.Course

@{
    ViewData["Title"] = "Create Course";
}

<h2>Create Course</h2>

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" style="color:red"></div>

    <div>
        <label>Title</label><br />
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" style="color:red"></span>
    </div>

    <div>
        <label>Credits</label><br />
        <input asp-for="Credits" type="number" class="form-control" />
        <span asp-validation-for="Credits" style="color:red"></span>
    </div>

    <br />
    <button type="submit">Save</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}